DB_HOST=localhost
DB_PORT=5432
DB_NAME=quickserve_db
DB_USERNAME=postgres
DB_PASSWORD=change_me

# Generate with (PowerShell): $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=change_me_to_a_long_random_base64_string
JWT_EXPIRATION_MS=86400000

# First admin account, created automatically on startup
ADMIN_NAME=QuickServe Admin
ADMIN_EMAIL=admin@quickserve.local
ADMIN_PASSWORD=change_me_strong_password

CORS_ALLOWED_ORIGINS=http://localhost:5173
